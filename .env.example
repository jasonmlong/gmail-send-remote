# Which backend the MCP server and CLI talk to:
#   sim        offline simulator (default, safe)
#   appsscript the lightweight Apps Script web app deployed in the user's account (recommended for real use)
#   gmail      direct Gmail API with a Cloud OAuth client (needs config/credentials.json)
GMAIL_SEND_PROVIDER=sim

# appsscript provider: the /exec URL and the token printed by setup() in the Apps Script editor
GMAIL_SEND_APPS_SCRIPT_URL=
GMAIL_SEND_APPS_SCRIPT_TOKEN=

# gmail provider: OAuth client file (Desktop app) and where the token is stored after `auth login`
GMAIL_SEND_CREDENTIALS=./config/credentials.json
GMAIL_SEND_TOKEN=./config/token.json

# Simulator store location
GMAIL_SEND_SIM_STORE=./.gmail-sim/store.json

# Set to 1 to allow send_draft. Off by default; drafts stay in Gmail for a person to send.
GMAIL_SEND_ALLOW_SEND=0

# Timezone for the "On <date> ... wrote:" line. Leave empty to use the connected
# account's Google Calendar timezone, with America/New_York as the last resort.
GMAIL_SEND_TIMEZONE=

# after-quote (Gmail default) or before-quote (Gmail's "insert signature before quoted text" setting)
GMAIL_SEND_SIGNATURE_PLACEMENT=after-quote

# Path to the voice/style guide markdown the agent should write in
GMAIL_SEND_STYLE_GUIDE=./config/style-guide.md
