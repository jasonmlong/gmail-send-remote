# .env for the OpenClaw host. Copy to .env on that machine and fill in the two
# blanks from the new Apps Script deployment. See docs/OPENCLAW-SETUP.md.
#
# This file is a template and is committed. The .env you create from it is
# git-ignored and holds a live credential: chmod 600 it and keep it out of
# images, backups and logs.

GMAIL_SEND_PROVIDER=appsscript

# The /exec URL from Deploy > New deployment on the NEW script project
GMAIL_SEND_APPS_SCRIPT_URL=

# The token printed once by mintDraftOnlyToken() with LABEL = 'openclaw'.
# Draft-only: it cannot send and cannot write Gmail settings. Never put the
# primary token here.
GMAIL_SEND_APPS_SCRIPT_TOKEN=

# Off here, and the script's own switch is off too. Both gates would have to
# open before anything could send, and the openclaw token lacks the capability
# regardless.
GMAIL_SEND_ALLOW_SEND=0

# Leave empty. The endpoint reports the mailbox owner's calendar timezone,
# which is what the "On <date> ... wrote:" line must use. Setting it to the
# server's timezone puts the wrong time in every quoted reply.
GMAIL_SEND_TIMEZONE=

GMAIL_SEND_SIGNATURE_PLACEMENT=after-quote

# Shipped in the repo, so the clone on this host writes in the right voice.
GMAIL_SEND_STYLE_GUIDE=./config/style-guide.md
