{
  "name": "gmail-send",
  "version": "0.1.0",
  "description": "Gmail-identical drafting engine, simulator, and MCP server so an AI agent can draft emails and replies inside Gmail with real signatures and proper threading.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "bin": { "gmail-send": "./dist/cli/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "node node_modules/tsx/dist/cli.mjs src/cli/index.ts",
    "mcp": "node node_modules/tsx/dist/cli.mjs src/mcp/server.ts",
    "sim:demo": "node node_modules/tsx/dist/cli.mjs src/cli/index.ts sim demo",
    "$scripts_note": "Invoked through node rather than npx on purpose: the npx shim truncates a multiline argument at its first newline on Windows, which silently cut email bodies down to the greeting."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "googleapis": "^148.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.1.0"
  }
}
